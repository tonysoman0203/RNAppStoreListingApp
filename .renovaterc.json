{
  "rebaseWhen": "conflicted",
  "automergeType": "branch",
  "ignorePaths": [
    "**/yarn.lock"
  ],
  "pruneStaleBranches": true,
  "dependencyDashboardAutoclose": true,
  "pruneBranchAfterAutomerge": true,
  "abandonmentThreshold": "30 days",
  "packageRules": [
    {
      "updateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "depTypeList": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}